@model List<MunicipalServicesApp.Models.ReportIssue>

@{
    ViewData["Title"] = "View All Reports";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h2 class="mb-0"><i class="bi bi-list-check me-2"></i>All Reported Issues</h2>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Location</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Date Reported</th>
                                <th>Status</th>
                                <th>Attachments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-primary">@report.Id</span></td>
                                    <td>@report.Location</td>
                                    <td><span class="badge bg-info">@report.Category</span></td>
                                    <td>
                                        @if (report.Description.Length > 50)
                                        {
                                            @report.Description.Substring(0, 50)<text>...</text>
                                        }
                                        else
                                        {
                                            @report.Description
                                        }
                                    </td>
                                    <td>@report.ReportedDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (report.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">@report.Status</span>
                                        }
                                        else if (report.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">@report.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@report.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (report.AttachmentPaths.Any())
                                        {
                                            <i class="bi bi-paperclip text-success"></i>
                                            <span>@report.AttachmentPaths.Count</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle me-2"></i>No reports have been submitted yet.
                </div>
            }

            <div class="mt-3">
                <a asp-controller="ReportIssue" asp-action="Index" class="btn btn-danger">
                    <i class="bi bi-plus-circle me-1"></i>Report New Issue
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-house-fill me-1"></i>Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
