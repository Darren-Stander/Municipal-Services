@model MunicipalServicesApp.Models.ReportIssue

@{
    ViewData["Title"] = "Report Submitted Successfully";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow border-success">
                <div class="card-header bg-success text-white text-center">
                    <h2><i class="bi bi-check-circle-fill me-2"></i>Report Submitted Successfully!</h2>
                </div>
                <div class="card-body">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">Thank You for Your Report!</h4>
                        <p>Your issue has been successfully submitted and our team will review it shortly.</p>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">Report Details</h5>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Report ID:</dt>
                                <dd class="col-sm-8"><span class="badge bg-primary">@Model.Id</span></dd>

                                <dt class="col-sm-4">Location:</dt>
                                <dd class="col-sm-8">@Model.Location</dd>

                                <dt class="col-sm-4">Category:</dt>
                                <dd class="col-sm-8"><span class="badge bg-info">@Model.Category</span></dd>

                                <dt class="col-sm-4">Description:</dt>
                                <dd class="col-sm-8">@Model.Description</dd>

                                <dt class="col-sm-4">Reported Date:</dt>
                                <dd class="col-sm-8">@Model.ReportedDate.ToString("MMMM dd, yyyy hh:mm tt")</dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8"><span class="badge bg-warning">@Model.Status</span></dd>

                                @if (Model.AttachmentPaths.Any())
                                {
                                    <dt class="col-sm-4">Attachments:</dt>
                                    <dd class="col-sm-8">
                                        @foreach (var attachment in Model.AttachmentPaths)
                                        {
                                            <div>
                                                <a href="@attachment" target="_blank" class="text-decoration-none">
                                                    <i class="bi bi-file-earmark-check me-1"></i>View Attachment
                                                </a>
                                            </div>
                                        }
                                    </dd>
                                }
                            </dl>
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <h5 class="alert-heading"><i class="bi bi-clock-history me-2"></i>What Happens Next?</h5>
                        <ul class="mb-0">
                            <li>Your report will be reviewed by our team within 24-48 hours</li>
                            <li>You can track the status using Report ID: <strong>@Model.Id</strong></li>
                            <li>We'll work to resolve the issue as quickly as possible</li>
                            <li>Updates will be posted to your report status</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
                        <a asp-controller="ReportIssue" asp-action="Index" class="btn btn-danger">
                            <i class="bi bi-plus-circle me-1"></i>Report Another Issue
                        </a>
                        <a asp-controller="ReportIssue" asp-action="ViewReports" class="btn btn-secondary">
                            <i class="bi bi-list-ul me-1"></i>View All Reports
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house-fill me-1"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
