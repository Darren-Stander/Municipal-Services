@model MunicipalServicesApp.Models.EventRsvp

@{
    ViewData["Title"] = "RSVP for Event";
    var evt = ViewBag.Event as MunicipalServicesApp.Models.LocalEvent;
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="bi bi-calendar-check me-2"></i>RSVP for Event</h2>
        </div>
        <div class="card-body">
            @if (evt != null)
            {
                <div class="alert alert-info">
                    <h5 class="alert-heading"><i class="bi bi-info-circle me-2"></i>@evt.Title</h5>
                    <hr>
                    <p class="mb-1"><strong><i class="bi bi-calendar3 me-2"></i>Date:</strong> @evt.EventDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                    <p class="mb-0"><strong><i class="bi bi-geo-alt me-2"></i>Location:</strong> @evt.Location</p>
                </div>
            }

            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Your Information</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Rsvp" method="post">
                                <input type="hidden" asp-for="EventId" />
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="FirstName" class="form-label fw-bold">
                                                <i class="bi bi-person me-1"></i>First Name
                                            </label>
                                            <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Enter your first name" />
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="LastName" class="form-label fw-bold">
                                                <i class="bi bi-person me-1"></i>Last Name
                                            </label>
                                            <input asp-for="LastName" class="form-control form-control-lg" placeholder="Enter your last name" />
                                            <span asp-validation-for="LastName" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="CellPhoneNumber" class="form-label fw-bold">
                                        <i class="bi bi-phone me-1"></i>Cell Phone Number
                                    </label>
                                    <input asp-for="CellPhoneNumber" class="form-control form-control-lg" placeholder="e.g., +27 82 123 4567" />
                                    <span asp-validation-for="CellPhoneNumber" class="text-danger"></span>
                                    <small class="form-text text-muted">We'll use this to send you event reminders and updates.</small>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Email" class="form-label fw-bold">
                                        <i class="bi bi-envelope me-1"></i>Email Address (Optional)
                                    </label>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="your.email@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                    <small class="form-text text-muted">Optional: Receive email confirmations and updates.</small>
                                </div>

                                <div class="alert alert-warning">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    <strong>Please Note:</strong> By submitting this RSVP, you confirm your attendance at this event. 
                                    You can only RSVP once per phone number.
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-check-circle me-2"></i>Confirm RSVP
                                    </button>
                                    <a asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left me-1"></i>Back to Event Details
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
