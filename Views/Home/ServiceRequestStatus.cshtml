@{
    ViewData["Title"] = "Service Request Status - Coming Soon";
}

<div class="container mt-5">
    <div class="text-center">
        <i class="bi bi-tools text-warning" style="font-size: 5rem;"></i>
        <h1 class="display-4 mt-3">Service Request Status</h1>
        <p class="lead text-muted">This feature is under development and will be available soon.</p>
        
        <div class="alert alert-info mt-4" role="alert">
            <h4 class="alert-heading">Coming Soon!</h4>
            <p>We're working hard to bring you the ability to track your service requests in real-time.</p>
            <hr>
            <p class="mb-0">Features will include:</p>
            <ul class="text-start mt-3">
                <li>Real-time status tracking</li>
                <li>Estimated resolution times</li>
                <li>Notification updates</li>
                <li>Historical request viewing</li>
            </ul>
        </div>

        <a asp-action="Index" class="btn btn-primary btn-lg mt-3">
            <i class="bi bi-house-fill me-2"></i>Back to Home
        </a>
    </div>
</div>
