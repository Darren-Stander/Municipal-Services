@model List<MunicipalServicesApp.Models.EventRsvp>

@{
    ViewData["Title"] = "Event RSVPs";
    var evt = ViewBag.Event as MunicipalServicesApp.Models.LocalEvent;
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="bi bi-people-fill me-2"></i>Event RSVPs</h2>
        </div>
        <div class="card-body">
            @if (evt != null)
            {
                <div class="card border-info mb-4">
                    <div class="card-header bg-info text-white">
                        <h4 class="mb-0">@evt.Title</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <p class="mb-2">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <strong>Date:</strong> @evt.EventDate.ToString("MMMM dd, yyyy")
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p class="mb-2">
                                    <i class="bi bi-clock text-success me-2"></i>
                                    <strong>Time:</strong> @evt.EventDate.ToString("hh:mm tt")
                                </p>
                            </div>
                            <div class="col-md-4">
                                <p class="mb-2">
                                    <i class="bi bi-geo-alt text-danger me-2"></i>
                                    <strong>Location:</strong> @evt.Location
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="alert alert-success">
                <h5 class="alert-heading"><i class="bi bi-people me-2"></i>Total RSVPs: @Model.Count</h5>
                <p class="mb-0">@Model.Count people have confirmed their attendance for this event.</p>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="bi bi-hash me-1"></i>#</th>
                                <th><i class="bi bi-person me-1"></i>Name</th>
                                <th><i class="bi bi-phone me-1"></i>Phone Number</th>
                                <th><i class="bi bi-envelope me-1"></i>Email</th>
                                <th><i class="bi bi-calendar-check me-1"></i>RSVP Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var rsvp in Model)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>
                                        <strong>@rsvp.FirstName @rsvp.LastName</strong>
                                    </td>
                                    <td>
                                        <a href="tel:@rsvp.CellPhoneNumber" class="text-decoration-none">
                                            <i class="bi bi-phone me-1"></i>@rsvp.CellPhoneNumber
                                        </a>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(rsvp.Email))
                                        {
                                            <a href="mailto:@rsvp.Email" class="text-decoration-none">
                                                <i class="bi bi-envelope me-1"></i>@rsvp.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not provided</span>
                                        }
                                    </td>
                                    <td>@rsvp.RsvpDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button class="btn btn-success" onclick="exportToCSV()">
                        <i class="bi bi-download me-1"></i>Export to CSV
                    </button>
                    <button class="btn btn-info" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i>Print List
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-exclamation-triangle fs-1"></i>
                    <h4 class="mt-3">No RSVPs Yet</h4>
                    <p>No one has RSVP'd for this event yet. Check back later!</p>
                </div>
            }

            <div class="mt-4">
                <a asp-action="ViewAllEvents" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to All Events
                </a>
                <a asp-action="Dashboard" class="btn btn-outline-primary">
                    <i class="bi bi-speedometer2 me-1"></i>Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function exportToCSV() {
            const eventTitle = '@(evt?.Title?.Replace("'", "\\'"))';
            let csv = 'Name,Phone Number,Email,RSVP Date\n';
            
            @foreach (var rsvp in Model)
            {
                <text>
                csv += '@rsvp.FirstName @rsvp.LastName,@rsvp.CellPhoneNumber,@(rsvp.Email ?? ""),@rsvp.RsvpDate.ToString("yyyy-MM-dd HH:mm")\n';
                </text>
            }

            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('hidden', '');
            a.setAttribute('href', url);
            a.setAttribute('download', `rsvps_${eventTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase()}.csv`);
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
}

<style>
    @@media print {
        .btn, nav, footer {
            display: none !important;
        }
    }
</style>
