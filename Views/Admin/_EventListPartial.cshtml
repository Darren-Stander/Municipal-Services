@model List<MunicipalServicesApp.Models.LocalEvent>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Event Date</th>
                    <th>Location</th>
                    <th>Priority</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in Model)
                {
                    <tr>
                        <td><span class="badge bg-primary">@evt.Id</span></td>
                        <td>
                            <strong>@evt.Title</strong>
                            <br />
                            <small class="text-muted">@(evt.Description.Length > 60 ? evt.Description.Substring(0, 60) + "..." : evt.Description)</small>
                        </td>
                        <td><span class="badge bg-info">@evt.Category</span></td>
                        <td>
                            <i class="bi bi-calendar3 me-1"></i>@evt.EventDate.ToString("MMM dd, yyyy")
                            <br />
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@evt.EventDate.ToString("hh:mm tt")</small>
                        </td>
                        <td>
                            <i class="bi bi-geo-alt me-1"></i>
                            @(evt.Location.Length > 30 ? evt.Location.Substring(0, 30) + "..." : evt.Location)
                        </td>
                        <td>
                            @if (evt.Priority == 1)
                            {
                                <span class="badge bg-danger">High (1)</span>
                            }
                            else if (evt.Priority == 2)
                            {
                                <span class="badge bg-warning text-dark">Medium (2)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Low (3)</span>
                            }
                        </td>
                        <td>
                            <small class="text-muted">@evt.CreatedDate.ToString("MMM dd, yyyy")</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info mt-3">
        <i class="bi bi-info-circle me-2"></i>
        Total Events: <strong>@Model.Count</strong>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>No events found.
    </div>
}
