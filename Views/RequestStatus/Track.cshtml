@model MunicipalServicesApp.Models.ViewModels.TrackRequestViewModel
@{
    ViewData["Title"] = "Track Service Request";
}

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        
      <div class="card shadow-sm">
   <div class="card-body text-center py-5">
       <i class="bi bi-search" style="font-size: 4rem; color: #ccc;"></i>
          <h4 class="mt-3">Request Not Found</h4>
       <p class="text-muted">Please check the request number and try again.</p>
      <form asp-action="QuickSearch" method="post" class="mt-4">
  <div class="row justify-content-center">
         <div class="col-md-6">
     <div class="input-group">
         <input type="text" class="form-control" name="requestNumber" placeholder="Enter Request Number" required>
 <button type="submit" class="btn btn-primary">
   <i class="bi bi-search"></i> Search
     </button>
   </div>
       </div>
        </div>
        </form>
      <a asp-action="Index" class="btn btn-outline-secondary mt-3">
     <i class="bi bi-arrow-left"></i> Back to All Requests
      </a>
     </div>
   </div>
    }
  else if (Model.Request != null)
    {
        var request = Model.Request;
    
    <!-- Request Header -->
   <div class="row mb-4">
        <div class="col-12">
      <div class="d-flex justify-content-between align-items-start">
      <div>
       <h1 class="display-6">@request.Title</h1>
     <p class="text-muted">
      <code class="fs-5">@request.RequestNumber</code>
    </p>
            </div>
     <div class="text-end">
     <span class="badge bg-@request.StatusColor fs-6">@request.Status</span>
   <br />
    <span class="badge bg-@request.PriorityColor fs-6 mt-2">@request.Priority Priority</span>
     </div>
        </div>
            </div>
        </div>

        <div class="row">
     <!-- Main Content -->
    <div class="col-lg-8">
  <!-- Request Details -->
       <div class="card shadow-sm mb-4">
       <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Request Details</h5>
          </div>
         <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-6">
    <label class="text-muted small">Category</label>
       <p class="mb-0"><strong><i class="bi bi-tag"></i> @request.Category</strong></p>
       </div>
     <div class="col-md-6">
           <label class="text-muted small">Department</label>
     <p class="mb-0"><strong><i class="bi bi-building"></i> @request.Department</strong></p>
 </div>
</div>
    
          <div class="row mb-3">
       <div class="col-md-6">
<label class="text-muted small">Location</label>
          <p class="mb-0"><i class="bi bi-geo-alt"></i> @request.Location</p>
      </div>
              <div class="col-md-6">
       <label class="text-muted small">Submitted By</label>
  <p class="mb-0"><i class="bi bi-person"></i> @request.SubmittedBy</p>
       </div>
     </div>

    <div class="mb-3">
     <label class="text-muted small">Description</label>
          <p class="mb-0">@request.Description</p>
   </div>

    @if (!string.IsNullOrEmpty(request.AssignedTo))
          {
    <div class="mb-3">
   <label class="text-muted small">Assigned To</label>
           <p class="mb-0"><i class="bi bi-person-badge"></i> @request.AssignedTo</p>
     </div>
      }

       @if (!string.IsNullOrEmpty(request.Notes))
         {
          <div class="alert alert-info">
       <i class="bi bi-sticky"></i> <strong>Notes:</strong> @request.Notes
       </div>
           }
     </div>
    </div>

  <!-- Timeline -->
    <div class="card shadow-sm mb-4">
              <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Request Timeline</h5>
    </div>
      <div class="card-body">
     @if (Model.Timeline.Any())
       {
<div class="timeline">
     @for (int i = 0; i < Model.Timeline.Count; i++)
     {
      var item = Model.Timeline[i];
       var isLast = i == Model.Timeline.Count - 1;
          
                 <div class="timeline-item @(isLast ? "timeline-item-last" : "")">
               <div class="timeline-marker bg-@item.Color">
           <i class="bi @item.Icon text-white"></i>
       </div>
      <div class="timeline-content">
        <h6 class="mb-1">@item.Status</h6>
    <p class="text-muted small mb-1">@item.Date.ToString("MMMM dd, yyyy - hh:mm tt")</p>
  <p class="mb-0">@item.Description</p>
       </div>
      </div>
           }
   </div>
     }
     else
     {
  <p class="text-muted">No timeline information available.</p>
          }
   </div>
      </div>

        <!-- Related Requests (Graph) -->
     @if (Model.RelatedRequests.Any())
    {
    <div class="card shadow-sm mb-4">
             <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Related Requests (Graph Analysis)</h5>
     </div>
       <div class="card-body p-0">
    <div class="list-group list-group-flush">
           @foreach (var related in Model.RelatedRequests.Take(5))
    {
<a asp-action="Track" asp-route-id="@related.Id" class="list-group-item list-group-item-action">
      <div class="d-flex justify-content-between align-items-center">
       <div class="flex-grow-1">
        <small class="text-muted">@related.RequestNumber</small>
   <div><strong>@related.Title</strong></div>
           <div class="mt-1">
              <span class="badge bg-@related.StatusColor">@related.Status</span>
      <span class="badge bg-secondary">@related.Category</span>
     <small class="text-muted"><i class="bi bi-geo-alt"></i> @related.Location</small>
   </div>
   </div>
         <i class="bi bi-chevron-right"></i>
   </div>
       </a>
      }
       </div>
        </div>
       </div>
 }
    </div>

    <!-- Sidebar -->
       <div class="col-lg-4">
        <!-- Key Dates -->
        <div class="card shadow-sm mb-4">
         <div class="card-header bg-light">
             <h6 class="mb-0"><i class="bi bi-calendar-event"></i> Key Dates</h6>
      </div>
   <div class="card-body">
  <div class="mb-3">
<label class="text-muted small">Submitted</label>
         <p class="mb-0"><strong>@request.SubmittedDate.ToString("MMM dd, yyyy")</strong></p>
 <small class="text-muted">@request.DaysOpen days ago</small>
</div>

     @if (request.AssignedDate.HasValue)
  {
       <div class="mb-3">
          <label class="text-muted small">Assigned</label>
   <p class="mb-0"><strong>@request.AssignedDate.Value.ToString("MMM dd, yyyy")</strong></p>
  </div>
       }

      @if (request.InProgressDate.HasValue)
   {
      <div class="mb-3">
              <label class="text-muted small">Started</label>
       <p class="mb-0"><strong>@request.InProgressDate.Value.ToString("MMM dd, yyyy")</strong></p>
  </div>
    }

    @if (request.EstimatedCompletionDate.HasValue)
    {
         <div class="mb-3">
      <label class="text-muted small">Estimated Completion</label>
           <p class="mb-0"><strong>@request.EstimatedCompletionDate.Value.ToString("MMM dd, yyyy")</strong></p>
    @if (request.EstimatedCompletionDate.Value > DateTime.Now)
 {
            var daysLeft = (request.EstimatedCompletionDate.Value - DateTime.Now).Days;
       <small class="text-success">@daysLeft days remaining</small>
    }
     else if (request.Status != MunicipalServicesApp.Models.RequestStatus.Resolved && 
 request.Status != MunicipalServicesApp.Models.RequestStatus.Closed)
  {
           var daysOverdue = (DateTime.Now - request.EstimatedCompletionDate.Value).Days;
        <small class="text-danger">@daysOverdue days overdue</small>
     }
     </div>
       }

      @if (request.CompletedDate.HasValue)
    {
      <div class="mb-3">
         <label class="text-muted small">Completed</label>
      <p class="mb-0"><strong>@request.CompletedDate.Value.ToString("MMM dd, yyyy")</strong></p>
        </div>
       }
       </div>
      </div>

                <!-- Similar Requests -->
      @if (Model.SimilarRequests.Any())
  {
   <div class="card shadow-sm mb-4">
       <div class="card-header bg-light">
       <h6 class="mb-0"><i class="bi bi-collection"></i> Similar Requests</h6>
         </div>
       <div class="card-body p-0">
    <div class="list-group list-group-flush">
           @foreach (var similar in Model.SimilarRequests)
     {
      <a asp-action="Track" asp-route-id="@similar.Id" class="list-group-item list-group-item-action">
     <small class="text-muted">@similar.RequestNumber</small>
    <div><strong>@similar.Title</strong></div>
    <div class="mt-1">
                <span class="badge bg-@similar.StatusColor">@similar.Status</span>
          </div>
      </a>
     }
           </div>
      </div>
  </div>
      }

    <!-- Actions -->
     <div class="card shadow-sm">
   <div class="card-body">
     <a asp-action="Index" class="btn btn-outline-primary w-100 mb-2">
        <i class="bi bi-arrow-left"></i> Back to All Requests
    </a>
          <button onclick="window.print()" class="btn btn-outline-secondary w-100">
   <i class="bi bi-printer"></i> Print Details
   </button>
        </div>
    </div>
        </div>
        </div>
    }
</div>

@section Styles {
    <style>
  .timeline {
            position: relative;
 padding-left: 50px;
        }

        .timeline-item {
       position: relative;
   padding-bottom: 30px;
   border-left: 2px solid #dee2e6;
  }

   .timeline-item-last {
   border-left: 0;
 }

        .timeline-marker {
   position: absolute;
        left: -35px;
  width: 40px;
    height: 40px;
   border-radius: 50%;
display: flex;
       align-items: center;
  justify-content: center;
   font-size: 1.2rem;
       box-shadow: 0 0 0 4px #fff, 0 0 0 5px #dee2e6;
   }

      .timeline-content {
    padding-left: 20px;
        }

        @@media print {
  .btn, .card-header, nav, footer {
                display: none !important;
     }
   }
    </style>
}
